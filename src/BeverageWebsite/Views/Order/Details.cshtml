@model BeverageWebsite.ViewModels.OrderDetailsViewModel

@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<main class="container">
    <h1>Chi tiết đơn hàng</h1>

    @if (Model == null)
    {
        <p>Không thể hiển thị chi tiết đơn hàng.</p>
    }
    else
    {
        var statusLabel = "Không xác định";

        switch (Model.OrderStatus)
        {
            case "Pending":
                statusLabel = "Chờ xác nhận";
                break;
            case "Confirmed":
                statusLabel = "Đã xác nhận";
                break;
            case "Processing":
                statusLabel = "Đang xử lý";
                break;
            case "Completed":
                statusLabel = "Hoàn thành";
                break;
            case "Cancelled":
                statusLabel = "Đã hủy";
                break;
        }

        <dl class="dl-horizontal">
            <dt>Mã đơn</dt>
            <dd>#@Model.OrderId</dd>

            <dt>Ngày đặt</dt>
            <dd>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt>Trạng thái</dt>
            <dd>@statusLabel</dd>

            <dt>Tiền hàng</dt>
            <dd>@(Model.TotalAmount.ToString("N0") + " đ")</dd>

            <dt>Phí giao hàng</dt>
            <dd>@(Model.ShippingFee.ToString("N0") + " đ")</dd>

            <dt>Tổng thanh toán</dt>
            <dd>@(Model.FinalAmount.ToString("N0") + " đ")</dd>
        </dl>

        <h2>Sản phẩm đã đặt</h2>

        if (Model.Items == null || Model.Items.Count == 0)
        {
            <p>Không có thông tin sản phẩm trong đơn hàng.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Ảnh</th>
                            <th scope="col">Sản phẩm</th>
                            <th scope="col">Đơn giá</th>
                            <th scope="col">Số lượng</th>
                            <th scope="col">Giảm giá</th>
                            <th scope="col">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var productName = string.IsNullOrWhiteSpace(item.ProductName)
                                ? "Sản phẩm không khả dụng"
                                : item.ProductName;

                            <tr>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <span>Chưa có ảnh</span>
                                    }
                                    else
                                    {
                                        <img src="@Url.Content(item.ImageUrl)"
                                             alt="@productName"
                                             class="img-responsive" />
                                    }
                                </td>
                                <td>@productName</td>
                                <td>@(item.UnitPrice.ToString("N0") + " đ")</td>
                                <td>@item.Quantity</td>
                                <td>@(item.DiscountAmount.ToString("N0") + " đ")</td>
                                <td>@(item.LineTotal.ToString("N0") + " đ")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <p>
        @Html.ActionLink(
            "Quay lại đơn hàng của tôi",
            "Index",
            "Order",
            null,
            new { @class = "btn btn-default" })
    </p>
</main>
