<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Beverage Website</title>
</head>
<body>
    <nav class="navbar navbar-default" aria-label="Điều hướng chính">
        <div class="container">
            <ul class="nav navbar-nav">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li>@Html.ActionLink("Danh mục", "Index", "Category")</li>
                <li>@Html.ActionLink("Sản phẩm", "Index", "Product")</li>
            </ul>

            @if (!Request.IsAuthenticated)
            {
                <ul class="nav navbar-nav navbar-right">
                    <li>@Html.ActionLink("Đăng nhập", "Login", "Account")</li>
                    <li>@Html.ActionLink("Đăng ký", "Register", "Account")</li>
                </ul>
            }
            else
            {
                <ul class="nav navbar-nav navbar-right">
                    <li>@Html.ActionLink("Hồ sơ", "Profile", "Account")</li>
                </ul>

                using (Html.BeginForm(
                    "Logout",
                    "Account",
                    FormMethod.Post,
                    new { @class = "navbar-form navbar-right" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link navbar-btn">
                        Đăng xuất
                    </button>
                }
            }
        </div>
    </nav>

    @RenderBody()
</body>
</html>
