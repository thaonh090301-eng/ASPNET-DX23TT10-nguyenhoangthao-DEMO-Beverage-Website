@using System.Linq
@model IEnumerable<BeverageWebsite.Models.Product>

@{
    ViewBag.Title = "Sản phẩm";
    var keyword = ViewBag.Keyword as string ?? string.Empty;
    var hasKeyword = !string.IsNullOrWhiteSpace(keyword);
    var hasValidKeyword = hasKeyword && ViewData.ModelState.IsValid;
}

<main>
    <h1>Sản phẩm</h1>

    @using (Html.BeginForm(
        "Index",
        "Product",
        FormMethod.Get,
        new { @class = "form-inline", role = "search" }))
    {
        <div class="form-group">
            <label class="sr-only" for="keyword">Từ khóa tìm kiếm</label>
            <input type="text"
                   id="keyword"
                   name="keyword"
                   value="@keyword"
                   class="form-control"
                   placeholder="Nhập tên hoặc mô tả sản phẩm" />
        </div>
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        @Html.ActionLink(
            "Xóa tìm kiếm",
            "Index",
            "Product",
            null,
            new { @class = "btn btn-default" })
    }

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @if (hasValidKeyword)
    {
        <h2>Kết quả tìm kiếm cho: @keyword</h2>
    }

    @if (Model == null || !Model.Any())
    {
        if (hasValidKeyword)
        {
            <p>Không tìm thấy sản phẩm phù hợp.</p>
        }
        else if (!hasKeyword)
        {
            <p>Hiện chưa có sản phẩm.</p>
        }
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Ảnh</th>
                        <th scope="col">Tên sản phẩm</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Giá</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <span>Chưa có ảnh</span>
                                }
                                else
                                {
                                    <img src="@Url.Content(product.ImageUrl)"
                                         alt="@product.ProductName"
                                         class="img-responsive" />
                                }
                            </td>
                            <td>@product.ProductName</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(product.Description)
                                    ? "Không có mô tả."
                                    : product.Description)
                            </td>
                            <td>@product.Price.ToString("N0") ₫</td>
                            <td>@(product.IsActive ? "Hoạt động" : "Không hoạt động")</td>
                            <td>
                                @Html.ActionLink(
                                    "Xem chi tiết",
                                    "Details",
                                    "Product",
                                    new { id = product.ProductId },
                                    new { @class = "btn btn-default btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
