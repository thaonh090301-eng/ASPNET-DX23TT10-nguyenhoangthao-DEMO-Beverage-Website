@model BeverageWebsite.ViewModels.CartViewModel

@{
    ViewBag.Title = "Giỏ hàng";
    var errorMessage = TempData["ErrorMessage"] as string;
    var successMessage = TempData["SuccessMessage"] as string;
}

<main class="container">
    <h1>Giỏ hàng</h1>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (Model == null)
    {
        <p>Không thể hiển thị giỏ hàng.</p>
    }
    else if (Model.Items == null || Model.Items.Count == 0)
    {
        <p>Giỏ hàng của bạn hiện đang trống.</p>
        <p>
            @Html.ActionLink(
                "Tiếp tục mua sắm",
                "Index",
                "Product",
                null,
                new { @class = "btn btn-primary" })
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Ảnh</th>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col">Đơn giá</th>
                        <th scope="col">Số lượng</th>
                        <th scope="col">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var productName = string.IsNullOrWhiteSpace(item.ProductName)
                            ? "Sản phẩm không khả dụng"
                            : item.ProductName;

                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <span>Chưa có ảnh</span>
                                }
                                else
                                {
                                    <img src="@Url.Content(item.ImageUrl)"
                                         alt="@productName"
                                         class="img-responsive" />
                                }
                            </td>
                            <td>@productName</td>
                            <td>@(item.UnitPrice.ToString("N0") + " đ")</td>
                            <td>
                                @using (Html.BeginForm(
                                    "UpdateQuantity",
                                    "Cart",
                                    FormMethod.Post,
                                    new { @class = "form-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("cartItemId", item.CartItemId)

                                    <div class="form-group">
                                        <label class="sr-only"
                                               for="quantity-@item.CartItemId">
                                            Số lượng
                                        </label>
                                        <input type="number"
                                               id="quantity-@item.CartItemId"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               step="1"
                                               class="form-control" />
                                    </div>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        Cập nhật
                                    </button>
                                }
                            </td>
                            <td>@(item.LineTotal.ToString("N0") + " đ")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div>
            <p><strong>Tổng số lượng:</strong> @Model.TotalItems</p>
            <p>
                <strong>Tổng tiền:</strong>
                @(Model.CartTotal.ToString("N0") + " đ")
            </p>
        </div>

        <p>
            @Html.ActionLink(
                "Tiếp tục mua sắm",
                "Index",
                "Product",
                null,
                new { @class = "btn btn-default" })
        </p>
    }
</main>
