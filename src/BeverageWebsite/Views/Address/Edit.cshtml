@model BeverageWebsite.ViewModels.AddressInputViewModel

@{
    ViewBag.Title = "Chỉnh sửa địa chỉ giao hàng";
}

<main class="container">
    <div class="row">
        <div class="col-md-8">
            <h1>Chỉnh sửa địa chỉ giao hàng</h1>

            @using (Html.BeginForm(
                "Edit",
                "Address",
                FormMethod.Post,
                new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", ViewBag.AddressId)
                @Html.ValidationSummary(
                    true,
                    null,
                    new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(model => model.RecipientName, "Tên người nhận", new { @class = "control-label col-sm-3" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(model => model.RecipientName, new { @class = "form-control", maxlength = "200" })
                        @Html.ValidationMessageFor(model => model.RecipientName, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Phone, "Số điện thoại", new { @class = "control-label col-sm-3" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(model => model.Phone, new { @class = "form-control", maxlength = "20" })
                        @Html.ValidationMessageFor(model => model.Phone, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Street, "Địa chỉ đường", new { @class = "control-label col-sm-3" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(model => model.Street, new { @class = "form-control", maxlength = "255" })
                        @Html.ValidationMessageFor(model => model.Street, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Ward, "Phường hoặc xã", new { @class = "control-label col-sm-3" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(model => model.Ward, new { @class = "form-control", maxlength = "100" })
                        @Html.ValidationMessageFor(model => model.Ward, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.District, "Quận hoặc huyện", new { @class = "control-label col-sm-3" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(model => model.District, new { @class = "form-control", maxlength = "100" })
                        @Html.ValidationMessageFor(model => model.District, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.City, "Tỉnh hoặc thành phố", new { @class = "control-label col-sm-3" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(model => model.City, new { @class = "form-control", maxlength = "100" })
                        @Html.ValidationMessageFor(model => model.City, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-9">
                        @if (Model != null && Model.IsDefault)
                        {
                            <p class="help-block">Đây là địa chỉ mặc định. Trạng thái mặc định sẽ được giữ nguyên.</p>
                        }

                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>

                        @Html.ActionLink(
                            "Hủy",
                            "Index",
                            "Address",
                            null,
                            new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>
    </div>
</main>
