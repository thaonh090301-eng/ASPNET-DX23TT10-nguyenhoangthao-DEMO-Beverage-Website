@model BeverageWebsite.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
}

<main>
    <h1>Chi tiết danh mục</h1>

    <dl class="dl-horizontal">
        <dt>Tên danh mục</dt>
        <dd>@Model.CategoryName</dd>

        <dt>Mô tả</dt>
        <dd>
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "Không có mô tả."
                : Model.Description)
        </dd>

        <dt>Trạng thái</dt>
        <dd>@(Model.IsActive ? "Hoạt động" : "Không hoạt động")</dd>
    </dl>

    <p>
        @Html.ActionLink(
            "Xem sản phẩm thuộc danh mục",
            "Index",
            "Product",
            new { categoryId = Model.CategoryId },
            new { @class = "btn btn-primary" })
        @Html.ActionLink(
            "Quay lại danh sách",
            "Index",
            "Category",
            null,
            new { @class = "btn btn-default" })
    </p>
</main>
