@model BeverageWebsite.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
}

<main class="public-shell category-detail-page">
    <section class="category-intro-card">
        <div class="category-intro-card__decoration" aria-hidden="true">
            <span>☕</span>
        </div>

        <div class="category-intro-card__content">
            <p class="public-page-header__eyebrow">Một góc hương vị dành cho bạn</p>
            <h1>@Model.CategoryName</h1>
            <p class="category-intro-card__description">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "Một nhóm đồ uống thú vị đang chờ bạn khám phá."
                    : Model.Description)
            </p>

            @if (Model.IsActive)
            {
                <span class="category-card__status status-chip status-chip--completed">
                    Đang phục vụ
                </span>
            }
            else
            {
                <span class="category-card__status status-chip status-chip--neutral">
                    Tạm ẩn
                </span>
            }

            <div class="category-intro-card__actions">
                @Html.ActionLink(
                    "Xem các món trong danh mục",
                    "Index",
                    "Product",
                    new { categoryId = Model.CategoryId },
                    new { @class = "btn btn-primary" })

                @Html.ActionLink(
                    "Quay lại danh mục",
                    "Index",
                    "Category",
                    null,
                    new { @class = "btn btn-default" })
            </div>
        </div>
    </section>
</main>
