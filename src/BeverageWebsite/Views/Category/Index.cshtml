@using System.Linq
@model IEnumerable<BeverageWebsite.Models.Category>

@{
    ViewBag.Title = "Danh mục sản phẩm";
}

<main class="public-shell category-page">
    <header class="public-page-header">
        <p class="public-page-header__eyebrow">Khám phá theo sở thích</p>
        <h1>Danh mục sản phẩm</h1>
        <p class="public-page-header__lead">
            Chọn một nhóm đồ uống phù hợp với tâm trạng của bạn hôm nay.
        </p>
    </header>

    @if (Model == null || !Model.Any())
    {
        <section class="public-empty-state" aria-labelledby="empty-category-title">
            <span class="public-empty-state__icon" aria-hidden="true">☕</span>
            <h2 id="empty-category-title">Danh mục đang được chuẩn bị</h2>
            <p>Hiện chưa có danh mục sản phẩm. Mời bạn quay lại sau nhé.</p>
        </section>
    }
    else
    {
        var categoryIndex = 0;

        <div class="category-card-grid">
            @foreach (var category in Model)
            {
                var toneClass = "category-card--cream";

                switch (categoryIndex % 4)
                {
                    case 1:
                        toneClass = "category-card--sage";
                        break;
                    case 2:
                        toneClass = "category-card--pink";
                        break;
                    case 3:
                        toneClass = "category-card--peach";
                        break;
                }

                <article class="category-card @toneClass">
                    <span class="category-card__icon" aria-hidden="true">☕</span>

                    <div class="category-card__content">
                        <div class="category-card__heading">
                            <h2>
                                @Html.ActionLink(
                                    category.CategoryName,
                                    "Details",
                                    "Category",
                                    new { id = category.CategoryId },
                                    new { @class = "category-card__title-link" })
                            </h2>

                            @if (category.IsActive)
                            {
                                <span class="category-card__status status-chip status-chip--completed">
                                    Đang phục vụ
                                </span>
                            }
                            else
                            {
                                <span class="category-card__status status-chip status-chip--neutral">
                                    Tạm ẩn
                                </span>
                            }
                        </div>

                        <p class="category-card__description">
                            @(string.IsNullOrWhiteSpace(category.Description)
                                ? "Một góc hương vị đang chờ bạn khám phá."
                                : category.Description)
                        </p>
                    </div>

                    @Html.ActionLink(
                        "Xem các món",
                        "Index",
                        "Product",
                        new { categoryId = category.CategoryId },
                        new { @class = "btn btn-primary category-card__action" })
                </article>

                categoryIndex++;
            }
        </div>
    }
</main>
