@using System.Linq
@model IEnumerable<BeverageWebsite.Models.Category>

@{
    ViewBag.Title = "Danh mục sản phẩm";
}

<main>
    <h1>Danh mục sản phẩm</h1>

    @if (Model == null || !Model.Any())
    {
        <p>Hiện chưa có danh mục sản phẩm.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Tên danh mục</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "Không có mô tả."
                                    : category.Description)
                            </td>
                            <td>@(category.IsActive ? "Hoạt động" : "Không hoạt động")</td>
                            <td>
                                @Html.ActionLink(
                                    "Xem chi tiết",
                                    "Details",
                                    "Category",
                                    new { id = category.CategoryId },
                                    new { @class = "btn btn-default btn-sm" })
                                @Html.ActionLink(
                                    "Xem sản phẩm",
                                    "Index",
                                    "Product",
                                    new { categoryId = category.CategoryId },
                                    new { @class = "btn btn-primary btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
