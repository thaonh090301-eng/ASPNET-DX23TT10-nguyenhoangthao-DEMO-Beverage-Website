@using System.Linq
@model IEnumerable<BeverageWebsite.ViewModels.AdminProductItemViewModel>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<main>
    <h1>Quản lý sản phẩm</h1>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <p>
        @Html.ActionLink(
            "Thêm sản phẩm",
            "CreateProduct",
            "Admin",
            null,
            new { @class = "btn btn-primary" })
        @Html.ActionLink(
            "Quản lý loại đồ uống",
            "Categories",
            "Admin",
            null,
            new { @class = "btn btn-default" })
        @Html.ActionLink(
            "Quản lý tồn kho",
            "Inventory",
            "Admin",
            null,
            new { @class = "btn btn-default" })
        @Html.ActionLink(
            "Quay lại quản trị",
            "Index",
            "Admin",
            null,
            new { @class = "btn btn-default" })
    </p>

    @if (Model == null || !Model.Any())
    {
        <p>Hiện chưa có sản phẩm.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Loại đồ uống</th>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col">Giá</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryName</td>
                            <td>@item.ProductName</td>
                            <td>@item.Price.ToString("N0") ₫</td>
                            <td>@(item.IsActive ? "Đang bán" : "Ngừng bán")</td>
                            <td>
                                @Html.ActionLink(
                                    "Sửa",
                                    "EditProduct",
                                    "Admin",
                                    new { id = item.ProductId },
                                    new { @class = "btn btn-default btn-sm" })
                                @using (Html.BeginForm(
                                    "DeleteProduct",
                                    "Admin",
                                    FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("productId", item.ProductId)
                                    <button
                                        type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
