@using System.Linq
@model IEnumerable<BeverageWebsite.ViewModels.AdminProductItemViewModel>

@functions {
    private static string GetBadgeDisplayName(string badgeType)
    {
        switch (badgeType)
        {
            case "Featured":
                return "Món nổi bật";
            case "BestSeller":
                return "Best seller";
            case "New":
                return "Món mới";
            default:
                return null;
        }
    }

    private static string GetBadgeChipClass(string badgeType)
    {
        switch (badgeType)
        {
            case "Featured":
                return "status-chip--pending";
            case "BestSeller":
                return "status-chip--processing";
            case "New":
                return "status-chip--confirmed";
            default:
                return "status-chip--neutral";
        }
    }
}

@{
    ViewBag.Title = "Quản lý sản phẩm";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<main class="admin-shell">
    <header class="admin-page-header">
        <p class="admin-page-kicker">Danh mục kinh doanh</p>
        <h1>Quản lý sản phẩm</h1>
        <p class="admin-page-lead">
            Theo dõi thực đơn, giá bán và trạng thái hiển thị của từng sản phẩm.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <nav class="admin-toolbar" aria-label="Thao tác quản lý sản phẩm">
        <div class="admin-toolbar__actions">
            @Html.ActionLink(
                "Thêm sản phẩm",
                "CreateProduct",
                "Admin",
                null,
                new { @class = "btn btn-primary" })
            @Html.ActionLink(
                "Quản lý loại đồ uống",
                "Categories",
                "Admin",
                null,
                new { @class = "btn btn-default" })
            @Html.ActionLink(
                "Quản lý tồn kho",
                "Inventory",
                "Admin",
                null,
                new { @class = "btn btn-default" })
            @Html.ActionLink(
                "Quay lại quản trị",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-default" })
        </div>
    </nav>

    @if (Model == null || !Model.Any())
    {
        <section class="admin-empty-state">
            <span class="admin-empty-state__icon" aria-hidden="true">SP</span>
            <h2>Chưa có sản phẩm</h2>
            <p>Hãy thêm sản phẩm đầu tiên để bắt đầu xây dựng thực đơn.</p>
        </section>
    }
    else
    {
        <section class="admin-table-card" aria-labelledby="product-table-title">
            <h2 id="product-table-title" class="sr-only">Danh sách sản phẩm</h2>
            <div class="table-responsive admin-table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Loại đồ uống</th>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col">Giá</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var badgeDisplayName = GetBadgeDisplayName(item.BadgeType);
                        var badgeChipClass = GetBadgeChipClass(item.BadgeType);

                        <tr>
                            <td>@item.CategoryName</td>
                            <td>
                                <strong>@item.ProductName</strong>
                                <div>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="status-chip status-chip--active">Trang chủ</span>
                                    }
                                    @if (!string.IsNullOrEmpty(badgeDisplayName))
                                    {
                                        <span class="status-chip @badgeChipClass">@badgeDisplayName</span>
                                    }
                                </div>
                            </td>
                            <td class="admin-table__amount">@item.Price.ToString("N0") ₫</td>
                            <td>
                                <span class="status-chip @(item.IsActive ? "status-chip--active" : "status-chip--inactive")">
                                    @(item.IsActive ? "Đang bán" : "Ngừng bán")
                                </span>
                            </td>
                            <td class="admin-table__actions">
                                @Html.ActionLink(
                                    "Sửa",
                                    "EditProduct",
                                    "Admin",
                                    new { id = item.ProductId },
                                    new { @class = "btn btn-default btn-sm" })
                                @using (Html.BeginForm(
                                    "DeleteProduct",
                                    "Admin",
                                    FormMethod.Post,
                                    new { @class = "admin-inline-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("productId", item.ProductId)
                                    <button
                                        type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>
    }
</main>
