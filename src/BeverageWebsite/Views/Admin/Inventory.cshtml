@using System.Linq
@model IEnumerable<BeverageWebsite.ViewModels.AdminInventoryItemViewModel>

@{
    ViewBag.Title = "Quản lý tồn kho";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<main class="admin-shell">
    <header class="admin-page-header">
        <p class="admin-page-kicker">Nguồn hàng hôm nay</p>
        <h1>Quản lý tồn kho</h1>
        <p class="admin-page-lead">
            Kiểm tra số lượng còn lại và cập nhật tồn kho cho từng sản phẩm đang kinh doanh.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <nav class="admin-toolbar" aria-label="Điều hướng quản lý tồn kho">
        <div class="admin-toolbar__actions">
            @Html.ActionLink(
                "Quay lại quản trị",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-default" })
        </div>
    </nav>

    @if (Model == null || !Model.Any())
    {
        <section class="admin-empty-state">
            <span class="admin-empty-state__icon" aria-hidden="true">TK</span>
            <h2>Chưa có sản phẩm đang kinh doanh</h2>
            <p>Sản phẩm đang bán sẽ xuất hiện tại đây để bạn theo dõi tồn kho.</p>
        </section>
    }
    else
    {
        <section class="admin-table-card" aria-labelledby="inventory-table-title">
            <h2 id="inventory-table-title" class="sr-only">Danh sách tồn kho</h2>
            <div class="table-responsive admin-table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Danh mục</th>
                        <th scope="col">Sản phẩm</th>
                        <th scope="col">Giá</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Tồn kho</th>
                        <th scope="col">Ngưỡng nhập lại</th>
                        <th scope="col">Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryName</td>
                            <td><strong>@item.ProductName</strong></td>
                            <td class="admin-table__amount">@item.Price.ToString("N0") ₫</td>
                            <td>
                                <span class="status-chip @(item.IsInStock ? "status-chip--in-stock" : "status-chip--out-of-stock")">
                                    @(item.IsInStock ? "Còn món" : "Tạm hết món")
                                </span>
                            </td>
                            <td>@item.StockQuantity</td>
                            <td>@item.ReorderLevel</td>
                            <td>
                                @if (item.HasInventory)
                                {
                                    using (Html.BeginForm(
                                        "UpdateStock",
                                        "Admin",
                                        FormMethod.Post,
                                        new { @class = "form-inline admin-stock-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("productId", item.ProductId)
                                        <div class="form-group admin-stock-control">
                                            <label class="sr-only"
                                                   for="quantity-@item.ProductId">
                                                Tồn kho
                                            </label>
                                            <input type="number"
                                                   id="quantity-@item.ProductId"
                                                   name="quantity"
                                                   min="0"
                                                   value="@item.StockQuantity"
                                                   class="form-control" />
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            Cập nhật
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="status-chip status-chip--inactive">Thiếu dữ liệu kho</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>
    }
</main>
