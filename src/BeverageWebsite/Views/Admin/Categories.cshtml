@using System.Linq
@model IEnumerable<BeverageWebsite.Models.Category>

@{
    ViewBag.Title = "Quản lý loại đồ uống";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<main>
    <h1>Quản lý loại đồ uống</h1>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <p>
        @Html.ActionLink(
            "Thêm loại đồ uống",
            "CreateCategory",
            "Admin",
            null,
            new { @class = "btn btn-primary" })
        @Html.ActionLink(
            "Quay lại quản trị",
            "Index",
            "Admin",
            null,
            new { @class = "btn btn-default" })
    </p>

    @if (Model == null || !Model.Any())
    {
        <p>Hiện chưa có loại đồ uống.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Tên loại</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "Không có mô tả."
                                    : category.Description)
                            </td>
                            <td>
                                @(category.IsActive
                                    ? "Đang hoạt động"
                                    : "Không hoạt động")
                            </td>
                            <td>
                                @Html.ActionLink(
                                    "Sửa",
                                    "EditCategory",
                                    "Admin",
                                    new { id = category.CategoryId },
                                    new { @class = "btn btn-default btn-sm" })
                                @using (Html.BeginForm(
                                    "DeleteCategory",
                                    "Admin",
                                    FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("categoryId", category.CategoryId)
                                    <button
                                        type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn xóa loại đồ uống này?');">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
