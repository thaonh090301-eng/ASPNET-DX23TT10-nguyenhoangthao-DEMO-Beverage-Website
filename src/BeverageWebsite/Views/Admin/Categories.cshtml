@using System.Linq
@model IEnumerable<BeverageWebsite.Models.Category>

@{
    ViewBag.Title = "Quản lý loại đồ uống";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<main class="admin-shell">
    <header class="admin-page-header">
        <p class="admin-page-kicker">Sắp xếp thực đơn</p>
        <h1>Quản lý loại đồ uống</h1>
        <p class="admin-page-lead">
            Tổ chức sản phẩm theo danh mục để khách hàng dễ dàng khám phá thực đơn.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <nav class="admin-toolbar" aria-label="Thao tác quản lý loại đồ uống">
        <div class="admin-toolbar__actions">
            @Html.ActionLink(
                "Thêm loại đồ uống",
                "CreateCategory",
                "Admin",
                null,
                new { @class = "btn btn-primary" })
            @Html.ActionLink(
                "Quay lại quản trị",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-default" })
        </div>
    </nav>

    @if (Model == null || !Model.Any())
    {
        <section class="admin-empty-state">
            <span class="admin-empty-state__icon" aria-hidden="true">DM</span>
            <h2>Chưa có loại đồ uống</h2>
            <p>Hãy tạo danh mục đầu tiên để sắp xếp các món thật gọn gàng.</p>
        </section>
    }
    else
    {
        <section class="admin-table-card" aria-labelledby="category-table-title">
            <h2 id="category-table-title" class="sr-only">Danh sách loại đồ uống</h2>
            <div class="table-responsive admin-table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Tên loại</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "Không có mô tả."
                                    : category.Description)
                            </td>
                            <td>
                                <span class="status-chip @(category.IsActive ? "status-chip--active" : "status-chip--inactive")">
                                    @(category.IsActive
                                        ? "Đang hoạt động"
                                        : "Không hoạt động")
                                </span>
                            </td>
                            <td class="admin-table__actions">
                                @Html.ActionLink(
                                    "Sửa",
                                    "EditCategory",
                                    "Admin",
                                    new { id = category.CategoryId },
                                    new { @class = "btn btn-default btn-sm" })
                                @using (Html.BeginForm(
                                    "DeleteCategory",
                                    "Admin",
                                    FormMethod.Post,
                                    new { @class = "admin-inline-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("categoryId", category.CategoryId)
                                    <button
                                        type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn xóa loại đồ uống này?');">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>
    }
</main>
